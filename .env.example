# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-telegram-token

# API-ключ Google AI Studio (бесплатно): https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key

# Подключение к БД.
# Для локального запуска (бот на хосте, Postgres в Docker) — оставьте localhost.
# В docker-compose значение переопределяется на host=db автоматически.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/krasok
